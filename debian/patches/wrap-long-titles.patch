+static int title_text_width(const char *text)
+{
+    int width, height;
+    imlib_get_text_size(text, &width, &height);
+    return width;
+}
+
+static size_t fit_title_prefix(char *dst, size_t dst_size, const char *src, int max_width)
+{
+    size_t bytes;
+
+    if (dst_size == 0 || max_width <= 0) return 0;
+
+    bytes = strlen(src);
+    if (bytes >= dst_size) bytes = dst_size - 1;
+
+    while (bytes > 0) {
+        strncpyutf8(dst, src, bytes);
+        bytes = strlen(dst);
+        if (title_text_width(dst) <= max_width) return bytes;
+        bytes--;
+    }
+
+    dst[0] = '\0';
+    return 0;
+}
+
+static void ellipsize_title(char *dst, size_t dst_size, const char *src, int max_width)
+{
+    const char *ellipsis = "..";
+    const size_t ellipsis_len = 2;
+    size_t bytes;
+
+    if (dst_size == 0) return;
+    dst[0] = '\0';
+    if (max_width <= 0 || *src == '\0') return;
+
+    if (strlen(src) < dst_size) {
+        strcpy(dst, src);
+        if (title_text_width(dst) <= max_width) return;
+    }
+
+    if (dst_size <= ellipsis_len + 1 || title_text_width(ellipsis) > max_width) return;
+
+    bytes = strlen(src);
+    if (bytes > dst_size - ellipsis_len - 1) bytes = dst_size - ellipsis_len - 1;
+
+    while (bytes > 0) {
+        strncpyutf8(dst, src, bytes);
+        bytes = strlen(dst);
+        strcat(dst, ellipsis);
+        if (title_text_width(dst) <= max_width) return;
+        if (bytes == 0) break;
+        bytes--;
+    }
+
+    strcpy(dst, ellipsis);
+}
+
+static void wrap_title(const char *src, char *line1, char *line2,
+                       size_t line_size, int max_width)
+{
+    const char *best_rest = NULL;
+    const char *fallback_rest = NULL;
+    size_t best_prefix_len = 0;
+    size_t fallback_prefix_len = 0;
+    const char *p;
+    char candidate[256];
+
+    if (line_size == 0) return;
+    line1[0] = '\0';
+    line2[0] = '\0';
+    if (max_width <= 0 || *src == '\0') return;
+
+    if (strlen(src) < line_size) {
+        strcpy(line1, src);
+        if (title_text_width(line1) <= max_width) return;
+    }
+
+    for (p = src; *p != '\0'; p++) {
+        size_t prefix_len;
+        const char *rest;
+
+        if (*p != ' ') continue;
+        prefix_len = p - src;
+        while (prefix_len > 0 && src[prefix_len - 1] == ' ') prefix_len--;
+        rest = p + 1;
+        while (*rest == ' ') rest++;
+        if (prefix_len == 0 || *rest == '\0') continue;
+
+        strncpyutf8(candidate, src, prefix_len);
+        if (title_text_width(candidate) > max_width) continue;
+
+        fallback_prefix_len = prefix_len;
+        fallback_rest = rest;
+        if (title_text_width(rest) <= max_width) {
+            best_prefix_len = prefix_len;
+            best_rest = rest;
+        }
+    }
+
+    if (best_rest != NULL) {
+        strncpyutf8(line1, src, best_prefix_len);
+        strncpyutf8(line2, best_rest, line_size - 1);
+        return;
+    }
+
+    if (fallback_rest != NULL) {
+        strncpyutf8(line1, src, fallback_prefix_len);
+        ellipsize_title(line2, line_size, fallback_rest, max_width);
+        return;
+    }
+
+    size_t prefix_len = fit_title_prefix(line1, line_size, src, max_width);
+    if (prefix_len == 0) {
+        ellipsize_title(line1, line_size, src, max_width);
+        return;
+    }
+
+    const char *rest = src + prefix_len;
+    while (*rest == ' ') rest++;
+    ellipsize_title(line2, line_size, rest, max_width);
+}
+
 
